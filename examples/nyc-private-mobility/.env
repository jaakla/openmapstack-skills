# Northstar Mobility fixture credentials — TEMPLATE. Copy to `.env` and fill.
#
#   cp .env.example .env && chmod 600 .env
#   set -a && . ./.env && set +a
#
# `.env` is gitignored. Nothing here ever belongs in project.yaml: the
# manifest references `env:NAME` only, and `openmapstack validate` fails the
# project if a credential is ever inlined.
#
# Two identities per backend, and they must stay separate:
#   *_ADMIN_*  provisioning only — creates and destroys the fixture
#   the rest   the restricted analysis reader OpenMapStack reads through
#
# The acceptance gate is that the finished project reruns with ALL of these
# unset. Export them to provision and to capture snapshots; unset them before
# `openmapstack verify`.

# ---------------------------------------------------------------------------
# PostGIS — operational GIS (already working; local Docker is fine)
# ---------------------------------------------------------------------------
# docker run -d --name northstar-ops -e POSTGRES_PASSWORD=... \
#   -e POSTGRES_DB=northstar_ops -p 5432:5432 postgis/postgis:16-3.4
OMS_DEMO_POSTGIS_ADMIN_DSN=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/northstar_ops
OMS_DEMO_POSTGIS_READER_PASSWORD=CHANGE_ME
OMS_DEMO_POSTGIS_DSN=postgresql://oms_alpha_reader:CHANGE_ME@127.0.0.1:5432/northstar_ops

# ---------------------------------------------------------------------------
# BigQuery — historical warehouse
# ---------------------------------------------------------------------------
# GCP project id (not the project *number*, not the display name).
OMS_DEMO_BIGQUERY_PROJECT=northstar-demo-001

# Admin service-account key file: provisioning identity. Absolute path.
# Needs roles/bigquery.admin on the project (it creates datasets, loads rows,
# and creates row access policies).
OMS_DEMO_BIGQUERY_ADMIN_CREDENTIALS=/home/jaak/.secrets/northstar-bq-admin.json

# The restricted reader, as a BigQuery grantee. Keep the `serviceAccount:`
# prefix — security.sql interpolates this verbatim into GRANT/REVOKE and the
# row access policies.
OMS_DEMO_BIGQUERY_READER_PRINCIPAL=serviceAccount:oms-alpha-reader@northstar-demo-001.iam.gserviceaccount.com

# The restricted reader's key file: the identity OpenMapStack analyses with.
# IMPORTANT — security.sql grants this account roles/bigquery.dataViewer on
# the dataset, which is data access only. Running a query *also* needs
# roles/bigquery.jobUser at project level, and BigQuery's GRANT DDL cannot
# grant a project-level role, so it is not in security.sql. Grant it once:
#   gcloud projects add-iam-policy-binding $OMS_DEMO_BIGQUERY_PROJECT \
#     --member="$OMS_DEMO_BIGQUERY_READER_PRINCIPAL" \
#     --role=roles/bigquery.jobUser
# Without it discovery succeeds and every snapshot fails.
GOOGLE_APPLICATION_CREDENTIALS=/home/jaak/.secrets/northstar-bq-reader.json

# Optional. Column-level security on internal_cost / rider_reference needs a
# Data Catalog taxonomy, which is a separate IAM object. Leave empty and
# `provision.py verify` reports NOT CONFIGURED — honest, and not a pass.
# The reader must NOT hold roles/datacatalog.categoryFineGrainedReader on it.
OMS_DEMO_BIGQUERY_POLICY_TAG=

# Dataset names and location are flags with defaults, not env vars:
#   --bigquery-dataset northstar_analytics
#   --bigquery-restricted-dataset northstar_analytics_restricted
#   --bigquery-location US
# Override on the provision.py command line if your org pins a region.

# ---------------------------------------------------------------------------
# MotherDuck — private market overlay
# ---------------------------------------------------------------------------
# Admin token: creates the database and loads it. Created from the token
# settings in the MotherDuck web UI (exact menu path varies by release).
OMS_DEMO_MOTHERDUCK_ADMIN_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..KHOxcNs0nGUSyIx3ujkJRg96z2JHl1ooOeDYNq4566g

# The analysis token: a SEPARATE token, scoped read-only. `provision.py
# verify` probes it with a zero-row INSERT and reports
# "token is read-only: FAIL" if this is really a writable token — including
# if the admin token was pasted here by mistake. If read-only scoping is not
# available on the account, that FAIL is the honest result to report, not
# something to work around.
MOTHERDUCK_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..KHOxcNs0nGUSyIx3ujkJRg96z2JHl1ooOeDYNq4566g

# Database name is a flag with a default: --motherduck-database northstar_market
